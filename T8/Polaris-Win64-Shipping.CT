newmem:
  cmp [rbx+00000004],(int)0
  jne code
  mov [pcFinderPTR],rbx // 92D offset = Power Crush Value

code:
  cmp byte ptr [rbx+00000C1D],00
  jmp return

pcFinderPTR:
dd 0


pcFinder:
  jmp newmem
  nop 2
return:
registersymbol(pcFinder)

[DISABLE]

pcFinder:
  db 80 BB 1D 0C 00 00 00

unregistersymbol(pcFinder)
dealloc(newmem)
unregistersymbol(pcFinderPTR)


