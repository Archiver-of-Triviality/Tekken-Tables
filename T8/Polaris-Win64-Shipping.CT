// 80 BB 1D 0C 00 00 00 74 09 C7 47 2C 06 00 00 00

// == Animation info and frame data ==

aobscanmodule(pcFinder,Polaris-Win64-Shipping.exe,80 BB 1D 0C 00 00 00 74 09) // should be unique
